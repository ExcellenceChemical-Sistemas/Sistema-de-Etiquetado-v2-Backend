generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────
// USUARIO
// Espejo local de Supabase Auth: la autenticación (email +
// password) vive 100% en Supabase (auth.users), acá solo se
// guarda el rol y el nombre para mostrar en la UI. supabaseUserId
// es el id (UUID) que devuelve Supabase Auth al crear la cuenta.
// ──────────────────────────────────────────
model Usuario {
  id                           Int                   @id @default(autoincrement())
  supabaseUserId               String                @unique
  nombre                       String
  esAdmin                      Boolean               @default(false)
  esAdminKpis                  Boolean               @default(false) // gestiona accesos de KPIs/ISO de otros; no implica acceso propio automático
  activo                       Boolean               @default(true) // false = sin acceso al sistema pero conserva historial (ver PATCH /usuarios/:id/activo)
  // Refrigerio de cada usuario, en minutos desde medianoche (ej. 720 = 12:00pm). Null = sin
  // configurar, no se descuenta nada. Es escalonado por persona (ver PATCH /usuarios/:id/refrigerio,
  // exclusivo de Admin) — AlertasPedidosService lo usa para no contar el refrigerio como horas
  // hábiles al calcular si un pedido lleva 48h sin entregarse.
  refrigerioInicioMinutos      Int?
  refrigerioFinMinutos         Int?
  // Quién y cuándo desactivó la cuenta (null si está activa). Si ese admin se
  // elimina después, desactivadoPorId queda en null pero desactivadoEn se conserva.
  desactivadoEn                DateTime?
  desactivadoPorId             Int?
  desactivadoPor               Usuario?              @relation("UsuarioDesactivadoPor", fields: [desactivadoPorId], references: [id], onDelete: SetNull)
  desactivados                 Usuario[]             @relation("UsuarioDesactivadoPor")
  avatarUrl                    String?
  permisos                     Permiso[]
  createdAt                    DateTime              @default(now())
  trabajosImpresion            TrabajoImpresion[]
  archivosSubidos              Archivo[]
  accesosIndicador             AccesoIndicador[]
  accesoIso                    AccesoISO?
  pedidosCreados               Pedido[]              @relation("PedidosCreados")
  pedidosEditados              Pedido[]              @relation("PedidosEditados")
  notificaciones               Notificacion[]
  cotizacionesCreadas          Cotizacion[]          @relation("CotizacionesCreadas")
  cotizacionesEditadas         Cotizacion[]          @relation("CotizacionesEditadas")
  cotizacionesHistorialEditado CotizacionHistorial[]
  ausencias                    Ausencia[]            @relation("AusenciasDelUsuario")
  ausenciasRegistradas         Ausencia[]            @relation("AusenciasRegistradas")
}

model Permiso {
  id            Int     @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recurso       Recurso
  puedeVer      Boolean @default(false)
  puedeCrear    Boolean @default(false)
  puedeEditar   Boolean @default(false)
  puedeEliminar Boolean @default(false)

  @@unique([usuarioId, recurso])
}

enum Recurso {
  LOTES
  PRODUCTOS
  FABRICANTES
  PLANTILLAS
  USUARIOS
  ETIQUETAS
  PEDIDOS
  // Antes Cotizaciones compartía PEDIDOS (mismo flujo de Joel). Se separó porque los
  // encargados son personas distintas: Charlie solo Pedidos, Joel solo Cotizaciones,
  // Alice ve ambos — hacía falta poder otorgar uno sin el otro.
  COTIZACIONES
  // Clientes también compartía PEDIDOS ("solo alimenta el autocomplete"), pero es un
  // recurso propio con encargados distintos a Pedidos y a Cotizaciones — mismo motivo
  // que la separación de arriba.
  CLIENTES
}

// ──────────────────────────────────────────
// FABRICANTE
// Un fabricante puede proveer varios lotes (1:N), incluso de
// productos distintos. No se permite repetir nombre — se valida
// con nombreNormalizado (minúsculas + sin acentos) para evitar
// duplicados tipo "Ácido Cítrico" vs "acido citrico".

// ──────────────────────────────────────────
model Fabricante {
  id                Int      @id @default(autoincrement())
  nombre            String   @unique
  nombreNormalizado String   @unique
  lotes             Lote[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("fabricantes")
}

// ──────────────────────────────────────────
// PRODUCTO
// Ya NO tiene fabricante fijo: un mismo producto puede tener
// lotes de distintos fabricantes a lo largo del tiempo (el
// fabricante varía por lote, no por producto). Nombre único a
// nivel global.
// ──────────────────────────────────────────
model Producto {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  nombreNormalizado  String   @unique
  nfpaSalud          Int? // 0-4
  nfpaInflamabilidad Int? // 0-4
  nfpaReactividad    Int?
  // Densidad en g/ml. Solo hace falta para líquidos (neto en ML/L): con ella la
  // tara se calcula como bruto - neto × densidad. Null = no se calcula tara.
  densidad           Float?
  // Pictogramas GHS/SGA que aplican: 'GHS01'..'GHS09'. Se muestran en la página del QR.
  pictogramasGhs     String[] @default([])
  // 'PELIGRO' | 'ATENCION' (palabra de advertencia GHS) y las frases H/P de la FDS,
  // una por elemento (ej. 'H314: Provoca quemaduras graves en la piel...').
  palabraAdvertencia String?
  frasesH            String[] @default([])
  frasesP            String[] @default([])
  // Path del objeto en el bucket, ej: "ficha-seguridad/producto-12/1234-ficha.pdf".
  // Opcional: un producto se puede registrar sin ficha y adjuntarla despues.
  fichaSeguridadUrl  String?
  // Idem, ej: "ficha-tecnica/producto-12/1234-ficha.pdf". Opcional.
  fichaTecnicaUrl    String?
  lotes              Lote[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("productos")
}

// ──────────────────────────────────────────
// PLANTILLA
// Independiente de Producto — se elige recién al generar la etiqueta.
// ──────────────────────────────────────────
model Plantilla {
  id                Int                @id @default(autoincrement())
  nombre            String             @unique
  archivo           String
  activa            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  trabajosImpresion TrabajoImpresion[]

  @@map("plantillas")
}

// ──────────────────────────────────────────
// LOTE
// Acá vive la relación real con Fabricante: cada lote de un
// producto puede venir de un fabricante distinto. Único por
// producto + fabricante + número de lote (un mismo número de
// lote podría repetirse entre fabricantes distintos, así que
// fabricanteId entra en el constraint para no chocar por error).
//
// fechaFabricacion / fechaVencimiento van como String (no DateTime):
// en el COA aparecen en formatos distintos según el proveedor —
// a veces solo mes/año ("10/2025"), a veces día/mes/año
// ("11/10/2025") — y se guarda tal cual se digita, sin forzar
// un único formato de fecha ni perder esa información.
// ──────────────────────────────────────────
model Lote {
  id                    Int                @id @default(autoincrement())
  numeroLote            String
  fechaFabricacion      String
  fechaVencimiento      String
  // Se calcula automáticamente en el service a partir de fechaVencimiento
  // (parseando "MM/AAAA" como último día de ese mes, o "DD/MM/AAAA" tal cual).
  // Nunca se edita a mano — solo existe para poder ordenar/filtrar
  // ("lotes que vencen este mes") sin tocar el texto original.
  fechaVencimientoOrden DateTime?          @db.Date
  coaUrl                String? // path del objeto en el bucket, ej: "lote-123/coa.pdf"
  productoId            Int
  producto              Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)
  fabricanteId          Int
  fabricante            Fabricante         @relation(fields: [fabricanteId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  trabajosImpresion     TrabajoImpresion[]

  @@unique([productoId, fabricanteId, numeroLote])
  @@index([numeroLote])
  @@index([fabricanteId])
  @@map("lotes")
}

enum EstadoTrabajoImpresion {
  PENDIENTE
  IMPRESO
  ERROR
}

model TrabajoImpresion {
  id              Int                    @id @default(autoincrement())
  loteId          Int
  lote            Lote                   @relation(fields: [loteId], references: [id])
  plantillaId     Int
  plantilla       Plantilla              @relation(fields: [plantillaId], references: [id])
  pesoBruto       String
  unidadBruto     String
  cantidadNeta    String?
  unidadNeta      String
  tara            String?
  // Código imposible de adivinar que va en el QR impreso; permite abrir la
  // página pública de trazabilidad de ESTA etiqueta (con sus pesos reales)
  // sin exponer ids autoincrementales. Null en trabajos anteriores al QR.
  token           String?                @unique
  // Cuántas veces se abrió la página pública de este QR y cuándo fue la última.
  escaneos        Int                    @default(0)
  ultimoEscaneoAt DateTime?
  // Cuántas veces, desde esa misma página pública, se vio/descargó el COA o
  // se vio la ficha de seguridad (FDS). Contadores aparte de `escaneos`
  // porque un escaneo no implica abrir ninguno de los dos documentos.
  coaVistas       Int                    @default(0)
  coaDescargas    Int                    @default(0)
  fdsVistas       Int                    @default(0)
  proforma        String
  imagenPath      String?
  estado          EstadoTrabajoImpresion @default(PENDIENTE)
  mensajeError    String?
  creadoPorId     Int
  creadoPor       Usuario                @relation(fields: [creadoPorId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("trabajos_impresion")
}

// ──────────────────────────────────────────
// MÓDULO PEDIDOS / TIEMPO DE ENTREGA
// Reemplaza el registro manual en Excel del lead time de pedidos.
// Cada fecha/hora de etapa (preparadoEn, salioEn, entregadoEn) se
// precarga con la hora actual al marcarla desde la UI, pero queda
// editable después — a diferencia de createdAt/updatedAt (automáticos,
// solo para trazabilidad interna, nunca se muestran como "dato a llenar").
// No hay un campo `estado` propio: la etapa se deriva de qué timestamps
// están seteados (evita que quede desincronizado de la fecha real).
// ──────────────────────────────────────────
enum TipoDocumentoCliente {
  RUC
  DNI
  CARNET_EXTRANJERIA
}

model Cliente {
  id                 Int                   @id @default(autoincrement())
  nombre             String                @unique
  nombreNormalizado  String                @unique
  tipoDocumento      TipoDocumentoCliente?
  numeroDocumento    String?
  direccion          String?
  celular            String?
  // Correo donde se avisa al cliente de su pedido (salio / entregado). Opcional: sin correo no se envia nada.
  email              String?
  // Cuando el personal registró que informó al cliente y este autorizó el uso de sus
  // datos de contacto (celular/correo) para avisarle de sus pedidos. Null = sin registro
  // (por ejemplo, clientes cargados antes de existir este campo).
  autorizaContactoEn DateTime?
  createdAt          DateTime              @default(now())
  pedidos            Pedido[]
  cotizaciones       Cotizacion[]

  @@map("clientes")
}

// Motivo por el que un pedido se sale de lo normal — cubre tanto demoras
// de preparación (falta de insumo) como formas de entrega o cierre
// distintas a la venta normal. Es un solo campo por pedido, no por etapa:
// en la práctica el Excel nunca tuvo más de una observación relevante por
// fila.
enum CategoriaObservacionPedido {
  INSUMO_EN_IMPORTACION
  INSUMO_SIN_STOCK
  RECOGE_EN_ALMACEN
  IMPORTACION_EXPORTACION
  CANCELADO
  OTRO
}

model Pedido {
  id                      Int                         @id @default(autoincrement())
  clienteId               Int
  cliente                 Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  numeroProforma          String                      @unique
  // Llave del enlace público de seguimiento (/p/<token>): la genera la base, 122 bits aleatorios.
  // Es lo único que protege esa página, así que nunca debe ser el id ni algo predecible.
  tokenSeguimiento        String                      @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  recibidoEn              DateTime                    @default(now())
  inicioPreparacionEn     DateTime?
  preparadoEn             DateTime?
  salioEn                 DateTime?
  entregadoEn             DateTime?
  // Cuando se le aviso al cliente por correo. Sirve para no avisar dos veces la misma etapa
  // (por ejemplo, si alguien corrige la fecha despues).
  avisoSalioEnviadoEn     DateTime?
  avisoEntregadoEnviadoEn DateTime?
  // Cuándo se creó la notificación interna de "pedido vencido" (ver NotificacionesModule /
  // AlertasPedidosService). Evita mandarla dos veces, mismo patrón que los avisos de arriba.
  alerta48hEnviadaEn      DateTime?
  categoriaObservacion    CategoriaObservacionPedido?
  detalleObservacion      String?
  creadoPorId             Int
  creadoPor               Usuario                     @relation("PedidosCreados", fields: [creadoPorId], references: [id])
  ultimoEditadoPorId      Int?
  ultimoEditadoPor        Usuario?                    @relation("PedidosEditados", fields: [ultimoEditadoPorId], references: [id])
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  notificaciones          Notificacion[]

  @@index([clienteId])
  @@map("pedidos")
}

// Notificación interna (no correo) para avisar dentro del sistema, ej. "este pedido lleva
// más de 48h hábiles sin marcarse como entregado" (AlertasPedidosService) o "esta cotización
// está aprobada hace más de 1h sin avisar a almacén" (AlertasCotizacionesService). El aviso al
// CLIENTE de un pedido (salió/entregado) sigue siendo un correo externo vía n8n — ver CLAUDE.md;
// esto es solo para avisos internos al personal (quien tiene acceso al recurso + los admins).
model Notificacion {
  id           Int              @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo         TipoNotificacion
  mensaje      String
  pedidoId     Int?
  pedido       Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cotizacionId Int?
  cotizacion   Cotizacion?      @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  leidaEn      DateTime?
  createdAt    DateTime         @default(now())

  @@index([usuarioId])
  @@map("notificaciones")
}

enum TipoNotificacion {
  PEDIDO_VENCIDO
  COTIZACION_SIN_AVISO_ALMACEN
}

// Seguimiento del proceso de cotización de Joel: mismo patrón que Pedido (fechas por etapa,
// sin columna "estado" propia — se deriva de cuáles están seteadas, ver derivarEstadoCotizacion
// en cotizaciones.service.ts). Insumos, cantidades y precio quedan en KEYFACIL ERP, acá solo se
// registran los 4 momentos que hoy Katherine carga a mano en Excel (DS del indicador comercial):
// llega el pedido del cliente -> Joel cotiza -> el cliente aprueba -> Joel avisa a almacén.
model Cotizacion {
  id                    Int                   @id @default(autoincrement())
  clienteId             Int
  cliente               Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  // Número de proforma de KEYFACIL (siempre "PF01-..."). Nulo hasta que Joel cotiza: no existe
  // todavía cuando recién llega el pedido del cliente. Postgres permite varios NULL en una
  // columna @unique, así que no choca entre sí mientras no se haya cotizado.
  numeroProforma        String?               @unique
  notas                 String?
  requerimientoEn       DateTime              @default(now())
  cotizacionEnviadaEn   DateTime?
  pedidoAprobadoEn      DateTime?
  avisoAlmacenEn        DateTime?
  // Cuándo se mandó el recordatorio de "falta avisar a almacén" (aprobado hace más de 1h sin
  // avisoAlmacenEn). Null = todavía no hizo falta. Evita mandar el mismo recordatorio dos veces.
  recordatorioEnviadoEn DateTime?
  creadoPorId           Int
  creadoPor             Usuario               @relation("CotizacionesCreadas", fields: [creadoPorId], references: [id])
  ultimoEditadoPorId    Int?
  ultimoEditadoPor      Usuario?              @relation("CotizacionesEditadas", fields: [ultimoEditadoPorId], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  historial             CotizacionHistorial[]
  notificaciones        Notificacion[]

  @@index([clienteId])
  @@map("cotizaciones")
}

// Historial inmutable de cada cambio a una fecha de etapa o a la proforma. Existe porque el
// PATCH de Cotizacion permite corregir cualquier campo cuantas veces haga falta (a propósito,
// para que se pueda cargar tarde) y sin esto no quedaba registro de qué decía antes ni de CUÁNDO
// se hizo el cambio de verdad (editadoEn es hora de servidor, no la editan ni Joel ni nadie). Es
// la diferencia real contra el Excel: ahí una celda se pisa sin dejar rastro, acá cada pisada
// queda escrita para siempre. Ver calcularAlertasCotizacion (alerta CARGA_TARDIA) en
// cotizaciones.service.ts, que compara editadoEn contra el valor que se cargó.
model CotizacionHistorial {
  id            Int        @id @default(autoincrement())
  cotizacionId  Int
  cotizacion    Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  campo         String
  valorAnterior String?
  valorNuevo    String?
  // Motivo obligatorio cuando un Admin corrige una etapa que Joel ya había marcado (ver
  // ForbiddenException en cotizaciones.service.ts). Null para el marcado normal (hora real de
  // servidor, no hace falta justificar) y para ediciones de requerimientoEn/numeroProforma.
  motivo        String?
  editadoPorId  Int
  editadoPor    Usuario    @relation(fields: [editadoPorId], references: [id])
  editadoEn     DateTime   @default(now())

  @@index([cotizacionId])
  @@map("cotizaciones_historial")
}

// Registro de vacaciones/licencias, cargado a mano por un admin cuando alguien
// sale. Sirve para que Cotizaciones (y a futuro Pedidos) marquen como
// sospechosa una fecha de etapa que el propio usuario cargó dentro de un
// período en el que no estaba trabajando — ver calcularAlertas() en
// cotizaciones.service.ts. No reemplaza ningún sistema de RR.HH., es
// deliberadamente mínimo: solo lo que hace falta para ese cruce.
model Ausencia {
  id              Int      @id @default(autoincrement())
  usuarioId       Int
  usuario         Usuario  @relation("AusenciasDelUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  desde           DateTime @db.Date // día calendario, inclusive
  hasta           DateTime @db.Date // día calendario, inclusive
  motivo          String?
  registradoPorId Int
  registradoPor   Usuario  @relation("AusenciasRegistradas", fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@index([usuarioId])
  @@map("ausencias")
}

// ──────────────────────────────────────────
// MÓDULO KPIs + DOCUMENTACIÓN ISO (Fase 3)
// Árbol de carpetas dinámico guardado en BD (no hay archivos
// reales en disco, los documentos van a Supabase Storage).
// Los permisos se atan al concepto (proceso, o ISO en general),
// NO a una carpeta puntual — así se heredan solos al clonar un
// año nuevo. La regla "PDF visible a todos" y "Obsoleto solo
// Alice" quedan hardcodeadas en el service (no en tabla), se
// migran a tabla más adelante si hace falta.
// ──────────────────────────────────────────
enum ModuloDocumentos {
  KPIS
  ISO
}

enum TipoCarpeta {
  ANIO
  PROCESO
  PERIODO
  RI
  DS
  OBSOLETO
}

enum ProcesoIndicador {
  COMERCIAL
  COMPRAS
  ALMACEN_DISTRIBUCION
  CONTROL_CALIDAD
  SGC
  DIRECCION_PLANEAMIENTO
  RRHH
  SERVICIOS_GENERALES
}

enum TipoArchivoDocumento {
  PDF
  WORD
  EXCEL
  POWERPOINT
}

model Carpeta {
  id             Int               @id @default(autoincrement())
  nombre         String
  carpetaPadreId Int?
  carpetaPadre   Carpeta?          @relation("CarpetaHijos", fields: [carpetaPadreId], references: [id], onDelete: Cascade)
  hijos          Carpeta[]         @relation("CarpetaHijos")
  modulo         ModuloDocumentos
  tipo           TipoCarpeta?
  proceso        ProcesoIndicador?
  archivos       Archivo[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([carpetaPadreId])
  @@map("carpetas")
}

model Archivo {
  id          Int                  @id @default(autoincrement())
  carpetaId   Int
  carpeta     Carpeta              @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  nombre      String
  tipo        TipoArchivoDocumento
  storagePath String
  subidoPorId Int
  subidoPor   Usuario              @relation(fields: [subidoPorId], references: [id])
  fechaSubida DateTime             @default(now())

  @@index([carpetaId])
  @@map("archivos")
}

model AccesoIndicador {
  id             Int              @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proceso        ProcesoIndicador
  puedeVer       Boolean          @default(false)
  puedeDescargar Boolean          @default(false)
  puedeAdjuntar  Boolean          @default(false)
  puedeEditar    Boolean          @default(false)
  puedeEliminar  Boolean          @default(false)

  @@unique([usuarioId, proceso])
  @@map("accesos_indicador")
}

model AccesoISO {
  id               Int     @id @default(autoincrement())
  usuarioId        Int     @unique
  usuario          Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  puedeVer         Boolean @default(false)
  puedeDescargar   Boolean @default(false)
  puedeAdjuntar    Boolean @default(false)
  puedeEditar      Boolean @default(false)
  puedeEliminar    Boolean @default(false)
  gestionaObsoleto Boolean @default(false) // ver+editar la carpeta Obsoleto (antes hardcodeado "solo Alice")

  @@map("accesos_iso")
}

// ──────────────────────────────────────────
// AUDITORÍA DE USUARIOS
// Quién hizo qué sobre las cuentas (desactivar, reactivar, eliminar, cambiar
// permisos). A propósito SIN claves foráneas y con los nombres copiados: el
// registro tiene que sobrevivir a que se elimine el usuario afectado o el admin.
// ──────────────────────────────────────────
model RegistroAuditoria {
  id             Int      @id @default(autoincrement())
  accion         String // USUARIO_DESACTIVADO | USUARIO_REACTIVADO | USUARIO_ELIMINADO | PERMISOS_ACTUALIZADOS
  actorId        Int?
  actorNombre    String
  objetivoId     Int?
  objetivoNombre String
  detalle        String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("registro_auditoria")
}
